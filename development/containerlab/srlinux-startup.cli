// Startup configuration applied to every SR Linux node.
//
// Two things only: export syslog to the bridge, and bring up eBGP so that a shut interface
// produces a session-down event as well as a link-down one. Everything else is default.

set / system logging remote-server 172.30.30.100 remote-port 5140 transport udp
set / system logging remote-server 172.30.30.100 subsystem local priority-severity 0 6

set / network-instance default protocols bgp autonomous-system 65000
set / network-instance default protocols bgp router-id 10.255.255.1
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable

commit save
